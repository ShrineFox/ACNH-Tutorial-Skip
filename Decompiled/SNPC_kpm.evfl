				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:006', true)
				EventFlowSystemActor.UIHotelRoomThemeSelectHandling()
				if EventFlowSystemActor.UIResultMenuDecide():
					EventFlowSystemActor.SetupHotelThemeMode(false)
					run Sub_Event350()
				else:
					run CancelTalk()
			else:
				EventFlowSystemActor.SetupHotelThemeMode(true)
				run Sub_Event350()
		else:
			run CancelTalk()
	else:
		# A VIP room, ye say! Well, the thing is, there aren't any guests around fer ye to invite. Usin' Animal Crossing series amiibo, ye can send an invite t…
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:010', true)

flow VIPTutorialCancel():
	# Arrr? Ye gonna quit? No worries. Do hope ye come back though.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:602_12', true)
	System.EventFlags['cPlayerTemp:IsStopSaveForHotel'] = false

flow VIPTutorialEndTalk():
	# Arr yarrr!
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:104', false)
	EventFlowSystemActor.SetLookAtTargetObject('cWherearenAmiiboDevice')
	MainNpc.TurnNeck(13, false)
	# Ye can use this <item>amiibo scanner to invite folks to a VIP room, yar?
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:104_01', false)
	MainNpc.TurnNeck(10, false)
	# If ye got an amiibo fer someone ye'd like ta invite, give it a try!
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:104_02', false)
	# Lookin' to the horizon a bit… Now that the hotel's up and runnin', I'm thinkin' it's about time I let folks redecorate rooms 1 to 8, yar? So if ye fe…
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:106', false)
	# Yar! And I'll keep givin' ye tickets once a day whenever ye help out with room decor.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:106_01', false)
	# Whether it's a VIP room or a regular one, if ye start from scratch, thar'll be a reward in it fer ye.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:107', false)
	# Help out whenever ye want, OK? Yarrr! I'll be countin' on ye!
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:108', false)
	System.EventFlags['cPlayer:AfterEditFirstRound'] = true

flow VipRoomOpenFirst():
	if System.EventFlags['cPlayer:HotelOpenVipRoom']:
		# Yarrr, that's it! All the guest rooms be complete! Thanks a ton!
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:601', false)
		System.EventFlags['cLand:TipsAllHotelRoomCoordinated'] = true
	else:
		# Just so ye know, all our guest rooms be done now! Ye worked real hard, and I'm real proud of ye.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:601_02', false)
	# But here's the thing… I'm gettin' a new kind o' guest room ready, aside from the ones ye worked on. We should be ready to launch tomorrow. Drop by if…
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:601_03', true)
	System.EventFlags['cPlayer:HotelVipRoomLeadIn'] = true

flow VipRoomTutorial():
	run Greeting()
	if EventFlowSystemActor.HotelNpcCheck('cIsExistNormalRoomNpc'):
		System.EventFlags['cPlayerTemp:IsStopSaveForHotel'] = true
		if System.EventFlags['cPlayer:VIPOpenExplanationAtFloor']:
			# Arrr! So, are ye gonna work on the VIP room decor?
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:602_13', false)
			if EventFlowSystemActor.GeneralTalkChoice2() == 0:
				run VIPFirstChallenge()
			else:
				run NotVIPFirstChallenge()
		elif (System.EventFlags['cPlayer:HotelOpenVipRoom']) or (System.EventFlags['cPlayer:HotelVipRoomLeadIn']):
			# Yar har har! I've set up a new type o' guest room. We call it…a VIP room.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:602_01', false)
			run Sub_Event281()
		elif System.EventFlags['cPlayer:SeqHotelEditTutorialDone']:
			# Just so ye know, all our guest rooms be done now! Ye worked real hard, and I'm real proud of ye. So, uh…thar be somethin' I'd like ta discuss with ye.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:602_02', false)
			# I've set up a kind o' guest room called…a VIP room.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:602_04', false)
			run Sub_Event281()
		else:
			# First things first… Can ye help with the decoratin'?
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:201', false)
			if EventFlowSystemActor.GeneralTalkChoice2() == 0:
				EventFlowSystemActor.SetupOrderInfoForVip()
				# Thank ye! Then let me tell ye what to do.
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:7304_01', false)
				# So, there's yer regular guest rooms and yer special VIP rooms. Our hotel's got both, ye know. And I was hopin' ye'd help decorate a VIP room, PLAYER.
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:7305', false)
				# VIP rooms are just fer invited guests, an' it's only fer one day.
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:7305_01', false)
				# Once a guest checks out, I'll go in an' clear everything outta the room.
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:7305_01_01', false)
				System.EventFlags['cPlayer:VIPOpenExplanationAtFloor'] = true
				# First though… Pick a guest ye'd like to invite to a VIP room from the ones stayin' at the hotel right now.
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:7305_02', true)
				EventFlowSystemActor.UIHotelVipNpcSelectHandling()
				if EventFlowSystemActor.UIResultMenuDecide():
					run PlayVipTutorial()
				else:
					run VIPTutorialCancel()
			else:
				run NotVIPFirstChallenge()
	else:
		if System.EventFlags['cPlayer:HotelVipRoomLeadIn']:
			# Arr, do ye be lookin' to help decorate a guest room?
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:601_05', false)
			# I'm sorry, but we won't be needin' yer help today.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:601_06', false)
		else:
			# Arr, do ye be lookin' to help decorate a guest room?
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:601_05', false)
			# Yar, I'm real sorry, but we don't have any rooms for ye to work on now.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:601_07', false)
		# If ye feel like it tomorrow, maybe ye can come back then!
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:601_08', false)