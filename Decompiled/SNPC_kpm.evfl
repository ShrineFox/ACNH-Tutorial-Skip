						if System.EventFlags['cPlayer:HotelVipRoomIntroductionDone']:
							run EditOrder()
						else:
							run VipRoomTutorial()
					else:
						run EditOrder()
				else:
					run UnlockRoomNews()
			case 1:
				run VIPExplanation()
			case 2:
				run EditOrder()
	else:
		run EntranceEditTutorial()

