flow CompleteOrder():
	System.EventFlags['cPlayerTemp:HotelReserveKpmDoneSpeak'] = false
	if not System.EventFlags['cPlayer:SeqHotelEditTutorialDone']:
		run ReturnEntranceTutorial()
		if System.EventFlags['cPlayer:EditTutorialFirstCustomer']:
			EventFlowSystemActor.SetTagFromSystem('cFlow', 'cDegit', 0, 200, '')
			# Now, if you'll get out yer phone, I can thank ye for all yer hard work. Here's <90:46:cd00> fer ye!
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:214', true)
			run Sub_Event795()
		else:
			EventFlowSystemActor.SetTagFromSystem('cFlow', 'cDegit', 0, 200, '')
			# Now, as a token o' me thanks, I'm givin' ye <90:46:cd00> ye can use here at the hotel. Get yer phone.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:217', true)
			run Sub_Event795()
	elif (System.EventFlags['cPlayer:HotelVipRoomIntroductionDone']) and ((EventFlowSystemActor.HotelOrderType() not in (0, 2, 3)) or (System.EventFlags['cPlayer:TodayGetHotelCoupon'])):
		if EventFlowSystemActor.IsWanderingInviteEdit():
			EventFlowSystemActor.SetTagHotelVisitorNpcName('cWanderingNpc', 0)
			# Looks like <115:1:cd00> be likin' the room! Arrr, that makes me so happy.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:102_03', false)
			EventFlowSystemActor.SetTagFromSystem('cFlow', 'cDegit', 0, 100, '')
			# As a little thanks fer recommendin' the hotel to our guest, I wanna give ye <90:46:cd00>.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:6004', true)
			EventFlowSystemActor.HotelOrderCallback('cFinish')
			EventFlowSystemActor.UIHotelTicketAppear()
			run GetHotelCouponHotelGuidance()
		elif (EventFlowSystemActor.IsEditHotelVIPRoom()) and (EventFlowSystemActor.HotelOrderType() == 0):
			EventFlowSystemActor.SetTagHotelVisitorNpcName('cInvitedVIP', 0)
			# Looks like <115:1:cd00> be likin' the room! Arrr, that makes me so happy.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:102_03', false)
			run NoNPC()
		else:
			run NoNPC()
	else:
		if (EventFlowSystemActor.IsEditHotelVIPRoom()) and (EventFlowSystemActor.HotelOrderType() == 0):
			EventFlowSystemActor.SetTagHotelVisitorNpcName('cInvitedVIP', 0)
			# Looks like <115:1:cd00> be likin' the room! Arrr, that makes me so happy.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:102_03', false)
			run EditRoomType()
		else:
			run EditRoomType()
		run EditEndText()
		if EventFlowSystemActor.IsWanderingInviteEdit():
			EventFlowSystemActor.SetTagFromSystem('cFlow', 'cDegit', 0, 300, '')
			# Can't thank ye enough fer decoratin' that VIP room and invitin' a guest. Here's <90:46:cd00> fer ye!
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:6009', true)
			run Sub_Event795()
		else:
			EventFlowSystemActor.SetTagFromSystem('cFlow', 'cDegit', 0, 200, '')
			# I'm givin' ye <90:46:cd00> as a li'l thank-ye gift. Please take out yer phone fer me, if ye would.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:101', true)
			run Sub_Event795()

