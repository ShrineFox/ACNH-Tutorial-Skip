		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:102_02', false)
		System.EventFlags['cPlayer:HotelRoomText'] = false

flow EditFirstRound():
	switch EventFlowSystemActor.FlagSystemIntValue9(9, 'cLand:HotelUnlockNormalRoomNumber'):
		case 2:
			if EventFlowSystemActor.CheckHotelRoomCreated('cRoom2'):
				run CanNotEdit()
			else:
				EventFlowSystemActor.SetEditHotelRoomNo(2)
				run EditRoomSetting()
		case 4:
			if not EventFlowSystemActor.CheckHotelRoomCreated('cRoom3'):
				EventFlowSystemActor.SetEditHotelRoomNo(3)
				run EditRoomSetting()
			elif EventFlowSystemActor.CheckHotelRoomCreated('cRoom4'):
				run CanNotEdit()
			else:
				EventFlowSystemActor.SetEditHotelRoomNo(4)
				run EditRoomSetting()
		case 6:
			if not EventFlowSystemActor.CheckHotelRoomCreated('cRoom5'):
				EventFlowSystemActor.SetEditHotelRoomNo(5)
				run EditRoomSetting()
			elif EventFlowSystemActor.CheckHotelRoomCreated('cRoom6'):
				run CanNotEdit()
			else:
				EventFlowSystemActor.SetEditHotelRoomNo(6)
				run EditRoomSetting()
		case 8:
			if not EventFlowSystemActor.CheckHotelRoomCreated('cRoom7'):
				EventFlowSystemActor.SetEditHotelRoomNo(7)
				run EditRoomSetting()
			elif not EventFlowSystemActor.CheckHotelRoomCreated('cRoom8'):
				EventFlowSystemActor.SetEditHotelRoomNo(8)
				run EditRoomSetting()
			elif not System.EventFlags['cLand:HotelUnlockVipRoom']:
				# Yar? Were ye hopin' to help with more room decoratin'? Apologies, but thar ain't any rooms to work on right now. I should have a new room ready by to…
