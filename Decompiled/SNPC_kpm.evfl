			elif System.EventFlags['cPlayer:SeqHotelEditTutorialDone']:
				run VipRoomOpenFirst()
			else:
				run VipRoomTutorial()
		default:
			return

flow EditFirstRoundThemeSelect():
	EventFlowSystemActor.UIHotelRoomThemeSelectHandling()
	if EventFlowSystemActor.UIResultMenuDecide():
		EventFlowSystemActor.SetupHotelThemeMode(false)
		EventFlowSystemActor.SetHotelThemeMessageTag('CurrentTheme', 0)
		if EventFlowSystemActor.RandomChoiceExcludePrevious2(2, true) == 0:
			# <140:28:cd00>? Oh, yarrr! I be gettin' real excited to see how that'll turn out!
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:057', false)
		else:
			# Oh, yarrr! <140:28:cd00>! I be thinkin' our guests're gonna love stayin' in a room like that.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:057_01', false)
		# Let's head up to the crow's nest.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:003', true)
		run GoToHotelRoom()
	else:
		# Arr? Are ye quittin'?
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:058', false)
		if EventFlowSystemActor.GeneralTalkChoice2() == 0:
			# OK, then let's be choosin' a theme!
