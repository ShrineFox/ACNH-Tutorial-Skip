flow AmiiboRoot():
	System.EventFlags['cPlayerTemp:HotelReserveKpmAmiiboSpeak'] = false
	EventFlowSystemActor.SetupOrderInfoForVip()
	EventFlowSystemActor.DecideHotelAmiiboNpcVIP()
	# Looks like ye nailed the invitation! We'd best be gettin' the room ready. Our guest be on the way!
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:5501', false)
	# Whatcha thinkin' as far as a theme fer the room?
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:013_01', false)
	if EventFlowSystemActor.GeneralTalkChoice2() == 0:
entrypoint Event917:
		# Alrighty then, pick a theme that speaks to ye!
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:7402', true)
		EventFlowSystemActor.UIHotelRoomThemeSelectHandling()
		if EventFlowSystemActor.UIResultMenuDecide():
			EventFlowSystemActor.SetupHotelThemeMode(false)
			# Yar! I'll be lookin' forward to seein' yer work!
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:013_03', false)
			run Sub_Event911()
		else:
			# Arr? Ye don't wanna choose a theme?
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:7400', false)
			if EventFlowSystemActor.GeneralTalkChoice2() == 0:
				run ReturnThemeSelect()
			else:
				# Gotcha! Go ahead and decorate however ye like!
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:7401', false)
				run Sub_Event911()
	else:
		EventFlowSystemActor.SetupHotelThemeMode(true)
		# Yar! I'll be lookin' forward to seein' yer work!
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:013_03', false)
		run Sub_Event911()

flow CanEditRoom():
