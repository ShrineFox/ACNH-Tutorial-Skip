flow UnlockRoom():
	if System.EventFlags['cLand:HotelUnlockVipRoom']:
		EventFlowSystemActor.ExitFlowchart()
	else:
		switch EventFlowSystemActor.FlagSystemIntValue9(9, 'cLand:HotelUnlockNormalRoomNumber'):
			case 2:
				if (EventFlowSystemActor.CheckHotelRoomCreated('cRoom1')) and (EventFlowSystemActor.CheckHotelRoomCreated('cRoom2')):
					System.EventFlags['cLand:HotelUnlockNormalRoomNumberReserve'] = 4
			case 4:
				if (EventFlowSystemActor.CheckHotelRoomCreated('cRoom3')) and (EventFlowSystemActor.CheckHotelRoomCreated('cRoom4')):
					System.EventFlags['cLand:HotelUnlockNormalRoomNumberReserve'] = 6
			case 6:
				if (EventFlowSystemActor.CheckHotelRoomCreated('cRoom5')) and (EventFlowSystemActor.CheckHotelRoomCreated('cRoom6')):
					System.EventFlags['cLand:HotelUnlockNormalRoomNumberReserve'] = 8
			case 8:
				if (EventFlowSystemActor.CheckHotelRoomCreated('cRoom7')) and (EventFlowSystemActor.CheckHotelRoomCreated('cRoom8')):
					if not System.EventFlags['cLand:HotelUnlockVipRoomReserve']:
						System.EventFlags['cPlayer:HotelOpenVipRoom'] = true
					System.EventFlags['cLand:HotelUnlockVipRoomReserve'] = true
			default:
				return

