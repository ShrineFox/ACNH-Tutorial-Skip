			run EditFirstRoundThemeSelect()
		else:
			# Aww, alrighty. Well, if ye change yer mind, lemme know.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:060', true)

flow EditOrder():
	run Greeting()
	if System.EventFlags['cPlayer:EditFirstRoundFinish']:
		run NextToEditOrder()
	else:
		switch EventFlowSystemActor.FlagSystemIntValue9(9, 'cLand:HotelUnlockNormalRoomNumber'):
			case 2:
				if EventFlowSystemActor.CheckHotelRoomCreated('cRoom2'):
					run CanNotEdit()
				else:
					run NextToEditOrder()
			case 4:
				if EventFlowSystemActor.CheckHotelRoomCreated('cRoom4'):
					run CanNotEdit()
				else:
					run NextToEditOrder()
			case 6:
				if EventFlowSystemActor.CheckHotelRoomCreated('cRoom6'):
					run CanNotEdit()
				else:
					run NextToEditOrder()
			case 8:
				if not EventFlowSystemActor.CheckHotelRoomCreated('cRoom8'):
					run NextToEditOrder()
				elif System.EventFlags['cPlayer:HotelVipRoomLeadIn']:
					# I be cookin' up a new kind o' guest room. Check in with me tomorrow at the earliest, yar?
					MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:601_04', true)
				else:
					run VipRoomOpenFirst()
			default:
				return

