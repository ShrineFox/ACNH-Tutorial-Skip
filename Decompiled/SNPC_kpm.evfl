flow EditEndText():
	if System.EventFlags['cPlayer:HotelNewVIPRoomText']:
		System.EventFlags['cPlayer:HotelNewVIPRoomText'] = false
	elif System.EventFlags['cPlayer:HotelNewRoomText']:
		# Thanks to ye, we've got another room ready fer our guests. I can't thank ye enough.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:102', false)
		System.EventFlags['cPlayer:HotelNewRoomText'] = false
	elif System.EventFlags['cPlayer:HotelRoomReworkText']:
		# The guest room be lookin' lovely because o' yer thoughtful work. Thank ye!
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:102_01', false)
		System.EventFlags['cPlayer:HotelRoomReworkText'] = false
	elif System.EventFlags['cPlayer:HotelRoomText']:
