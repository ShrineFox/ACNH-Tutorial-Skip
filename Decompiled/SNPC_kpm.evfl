flow EditRoot():
	if MainNpc.IsExistTakeldPlayerSuspendData():
		EventFlowSystemActor.RecoverOrderDataFromSuspendData()
		EventFlowSystemActor.SetHotelRoomNumberTag('cSuspend', 0)
		# Arrr…by the way…yer work in <50:1><140:29:cd00> is unfinished. Can ye pick up where ye left off?
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:003_01', true)
		run GoToHotelRoom()
	else:
		# Well, thank ye! Sooo, standard or VIP room? Which'll it be?
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:002_02', false)
		if EventFlowSystemActor.GeneralTalkChoice2() == 0:
			EventFlowSystemActor.SetupOrderInfoForVip()
			if EventFlowSystemActor.CheckHotelRoomCreated('cNowPlayerVIP'):
				# VIP room! Yar!
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:002_05', false)
				EventFlowSystemActor.SetTagHotelVisitorNpcName('cEditRoomGuest', 0)
				# We've got a guest stayin' there now. I'll hafta explain the deal to ol' <115:1:cd00>.
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:002_05_02', false)
				# Sooo… Did ye wanna start over or make changes to what ye have now? What're ye thinkin'?
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:002_07', false)
				if EventFlowSystemActor.GeneralTalkChoice2() == 0:
					run FromTheBeginning()
				else:
					run NotChangeTheme()
			else:
				run VIPRoot()
		else:
			run NomalRoomRoot()

