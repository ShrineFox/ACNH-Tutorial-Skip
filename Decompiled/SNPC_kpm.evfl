flow EditRoomType():
	switch EventFlowSystemActor.HotelOrderType():
		case 0:
			if EventFlowSystemActor.IsEditHotelVIPRoom():
				System.EventFlags['cPlayer:HotelNewVIPRoomText'] = true
			else:
				System.EventFlags['cPlayer:HotelNewRoomText'] = true
		case 1:
