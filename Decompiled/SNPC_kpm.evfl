	SubNpc.TurnNeck(11, false)
	MainNpc.TurnNeck(1, false)
	run `00_Demo_Fade`::FadeIn_Cmn(IsWait=true)
	fork:
		branch:
			# Oh! Arrre ye a guest from another island? Welcome to the <110:34> hotel!
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:207', false)
		branch:
			EventFlowSystemActor.WaitFrame(30)
			SubNpc.TurnNeck(0, true)
		branch:
			EventFlowSystemActor@sub2.WaitFrame(40)
			Player.TurnNeck(0, true)
	SubNpc.TurnNeck(11, true)
	EventFlowSystemActor.WaitFrame(10)
	Player.TurnNeck(11, true)
	# I wanted to see ISLAND, so I dropped by… It's a pretty fun place, so I kinda wanna stay longer. And then I saw this place, and I thought maybe I coul…
	SubNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:208', false)
	fork:
		branch:
			# Yarrr! Matter o' fact, a room's just opened up. We'd be happy to have ye as our guest.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:209', false)
		branch:
			EventFlowSystemActor.WaitFrame(30)
			SubNpc.TurnNeck(0, true)
		branch:
			EventFlowSystemActor@sub2.WaitFrame(40)
			Player.TurnNeck(0, true)
	SubNpc.TurnNeck(11, true)
	EventFlowSystemActor.WaitFrame(10)
	Player.TurnNeck(11, true)
	# Yay! Thanks!
	SubNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:210', false)
	fork:
		branch:
			# Ye'll be our very first guest. Lemme just show ye to yer room.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:211', false)
		branch:
			EventFlowSystemActor.WaitFrame(30)
			SubNpc.TurnNeck(0, true)
		branch:
			EventFlowSystemActor@sub2.WaitFrame(40)
			Player.TurnNeck(0, true)
	MainNpc.TurnNeck(10, false)
	fork:
		branch:
			# Can ye wait here fer a bit, PLAYER?
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:212', true)
		branch:
			EventFlowSystemActor@sub.WaitFrame(30)
			SubNpc.TurnNeck(11, true)
		branch:
			EventFlowSystemActor@sub2.WaitFrame(40)
			Player.TurnNeck(0, true)
	Player.TurnNeck(11, true)
	SubNpc.CharacterEmoticonAction('FaintSmile', false, '', 0, false)
	EventFlowSystemActor.WaitFrame(10)
	run `00_Demo_Fade`::FadeOut_Cmn(FadeType='cCircle', FadeColor='cBlack', FadeSpeed='cNormal', SoundDucking='cWorldDucking')
	SubNpc.NpcRequestAction(3)
	run CommonGuestDemoEnd()
	run `00_Demo_Fade`::FadeIn_Cmn(IsWait=true)
	# Thanks fer waitin'! I showed our guest to room 1. <110:31:cd01> was real happy!
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:212_01', false)
	# The stairs in the back'll get ye to the guest rooms. If ye ask me, it's never a bad idea to check on 'em!
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:219', false)
	# The hotel's open, and we be off to a great start! An' it's all because o' yer hard work. Thank ye, PLAYER. Really.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:213', false)
