flow Default():
	MainNpc.NpcChangeBlockWanderState('cBlockWander', '', 'NNPC_HotelGuest_NoRoom', 'Root', false, false, ArgFlag0=false, ArgInt0=0, ArgInt1=1, ArgInt2=0, ArgInt3=0)

flow FallPit():
	MainNpc.NpcAISetting(2, false)
	MainNpc.NpcAISetting(3, false)
	MainNpc.NpcAISetting(8, true)
	MainNpc.NpcChangeAIState('cFallPitHotel', '', 'NNPC_HotelGuest_Reaction', 'FallPit', false, false)

flow Hit():
	MainNpc.NpcChangeAIState('cHit', '', '', '', false, false)

flow InviteDemo():
	if MainNpc.NpcCheckStateSelectTiming('cInit'):
		MainNpc.NpcAISetting(2, false)
		MainNpc.NpcAISetting(3, false)
		MainNpc.NpcChangeWaitState('cWait', '', '', '', false, false, ArgFlag0=true, ArgInt0=0, ArgStr0='')
	else:
		MainNpc.NpcReservrForErase()

flow PassiveBln():
	if EventFlowSystemActor.RandomChoiceExcludePrevious2(2, true) == 0:
		# I'm thinking. A huh huh... It's neat.
		MainNpc.NpcBalloonRequest('System/Balloon/BLN_Approach:03_BO', 'cAppearNear', 'ApproachPassive', 0)
	else:
		# I wanna do a thing...but what?
		MainNpc.NpcBalloonRequest('System/Balloon/BLN_Approach:04_BO', 'cAppearNear', 'ApproachPassive', 0)

flow Root():
	MainNpc.NpcAIDefaultSetting(1)
	if EventFlowSystemActor.SystemCheckNowStage('cHotelEntrance'):
		run InviteDemo()
	elif MainNpc.EventFlags['cHotelNpcTemp:FallPit']:
		run FallPit()
	else:
		switch MainNpc.IsWarningInsect():
			case 0:
				MainNpc.NpcAISetting(2, false)
				MainNpc.NpcAISetting(3, false)
				MainNpc.NpcChangeAIState('cWarningInsect', '', 'NNPC_HotelGuest_Reaction', 'Poison', false, false)
			case 1:
				MainNpc.NpcChangeAIState('cWarningInsect', '', 'NNPC_HotelGuest_Reaction', 'Run', false, false)
			case 2:
				if MainNpc.EventFlags['cHotelNpcTemp:IsCalmlyWandering']:
					run Default()
				elif MainNpc.NpcCheckStateSelectTiming('cTalkEnd'):
					MainNpc.EventFlags['cHotelNpcTemp:IsCalmlyWandering'] = true
					run Default()
				elif (not EventFlowSystemActor.NetIsConnected()) and (not EventFlowSystemActor.IsSharePlay(0)) and (MainNpc.CheckWorkDataVIPEditNpc() not in (0, 1)):
					MainNpc.NpcChangeAIState('cHotelPassiveApproach', '', 'NNPC_HotelGuest_NoRoom', 'Root', false, false)
					run PassiveBln()
				else:
					run Default()