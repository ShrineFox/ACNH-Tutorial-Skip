flow BonusTalk():
	if EventFlowSystemActor.IsKppTradeBonusTalk('All', true):
		if EventFlowSystemActor.IsKppTradeBonusTalk('OnlyHighPrice', false):
			# Yar, PLAYER!
			MainNpc.OpenMessageWindow('TalkSNpc/kpp/SP_kpp:142', false)
			run HighPriceBonusTalk(KppAlreadyTakingOutPhone=false)
			run SendCoupon_End()
		else:
			EventFlowSystemActor.SetDIYTradeMessageTag('cAchiveRemakeBonusTicketNum', 0)
			switch EventFlowSystemActor.CheckKppTradeBonusFlag('cMultiPlay'):
				case 0:
					# Looks like ye've brought tons o' DIY stuff, yar? Now that makes me delivery trips even more worthwhile.
					MainNpc.OpenMessageWindow('TalkSNpc/kpp/SP_kpp:110', false)
					# Here's a little gift from yours truly, PLAYER. I'm givin' ye <90:46:cd00> ye can use at the hotel!
					MainNpc.OpenMessageWindow('TalkSNpc/kpp/SP_kpp:111', false)
					run Sub_Event159()
				case 1:
					# Yar, ye donated some customized work, didn't ye? Yar har har! Ye're a sly one, aren't ye?
					MainNpc.OpenMessageWindow('TalkSNpc/kpp/SP_kpp:113', false)
					# This be just a little somethin', but I want ye to have <90:46:cd00>. They're fer use at the hotel.
					MainNpc.OpenMessageWindow('TalkSNpc/kpp/SP_kpp:114', false)
					run Sub_Event159()
				case 2:
					# Looks like ye've brought tons o' DIY stuff, yar? Now that makes me delivery trips even more worthwhile.
					MainNpc.OpenMessageWindow('TalkSNpc/kpp/SP_kpp:110', false)
					# Plus, ye put some customized work in the box, yar? Ar har har har! Ye're a sneaky one, ain't ye?
					MainNpc.OpenMessageWindow('TalkSNpc/kpp/SP_kpp:116', false)
					# Here's a little gift from yours truly, PLAYER. I'm givin' ye <90:46:cd00> ye can use at the hotel!
					MainNpc.OpenMessageWindow('TalkSNpc/kpp/SP_kpp:111', false)
					run Sub_Event159()
				default:
					return

