local flow Sub_Event15(StructureType: str, StructureBuildPosType: str):
	run System_Structure_Common::DeletePreviewStructure(StructureType=StructureType, StructurePosType=StructureBuildPosType)
	EventFlowSystemActor.CloudIslandStructureCancelLock()
	EventFlowSystemActor.ExitFlowchart()

local flow Sub_Event21():
	EventFlowSystemActor.StructureDeletePreviewGuide(false)
	EventFlowSystemActor.CloudIslandStructureCancelLock()
	EventFlowSystemActor.ExitFlowchart()