flow CeilingFtrPickupError_ExistsOtherP():
	# You'll need to be alone in the room to remove things from the ceiling!
	Player.OpenMessageWindow('TalkSys/SYS_Telepathy:1109', true)

flow FenceBuildError_PlayingNet():
	# You have visitors, so maybe don't build any fences right now.
	Player.OpenMessageWindow('TalkSys/SYS_Telepathy:023', true)

flow FtrIndoorOperateError_ExistsVisitor():
	# It's rude to redecorate when you have company!
	Player.OpenMessageWindow('TalkSys/SYS_Telepathy:005', true)

flow FtrOperateError_ExistsVisitor():
	# There's company over right now, so take time to move it later!
	Player.OpenMessageWindow('TalkSys/SYS_Telepathy:013', true)

flow FtrPickupError_ExistsVisitor():
	# There's company over right now, so take time to tidy up later!
	Player.OpenMessageWindow('TalkSys/SYS_Telepathy:014', true)

flow RugPickupError_ExistsOtherP():
	# You'll need to be alone in the room to remove rugs.
	Player.OpenMessageWindow('TalkSys/SYS_Telepathy:1110', true)

flow WallFtrPickupError_ExistsOtherP():
	# You'll need to be alone in the room to remove things from the walls!
	Player.OpenMessageWindow('TalkSys/SYS_Telepathy:1108', true)