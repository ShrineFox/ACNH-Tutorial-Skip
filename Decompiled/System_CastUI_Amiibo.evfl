flow Root(NpadId: int = 0, ReadPadId: int = 0):
	SubflowResults[19] = 3
	run Obj_Common_AmiiboProcess::NFC_SettingChk()
	EventFlowSystemActor.CheckNfpController(NpadId)
	ReadPadId = NpadId
	EventFlowSystemActor.ReadAmiibo(ReadPadId)
	if EventFlowSystemActor.UIResultMenuDecide():
		if EventFlowSystemActor.CheckErrorType(1):
			run Obj_Common_AmiiboProcess::NFC_ReadError()
		elif not EventFlowSystemActor.IsAcceptableAmiibo():
			# This amiibo is not supported. Please use an Animal Crossing character's amiibo.
			Player.OpenMessageWindow('TalkSys/SYS_Common_AmiiboError:101', false)
		elif EventFlowSystemActor.CheckAmiiboNPC('cSpltMantaro'):
			# You can contact Cece or Viché with this amiibo. Who would you like to contact?
			Player.OpenMessageWindow('TalkObj/OBJ_WherearenAmiiboDevice:308', false)
			if EventFlowSystemActor.GeneralTalkChoice2() == 0:
				EventFlowSystemActor.ChangeAmiiboNPC('cSqu19')
				run Sub_grp_Event16(NpadId=NpadId, ReadPadId=ReadPadId)
			else:
				EventFlowSystemActor.ChangeAmiiboNPC('cSqu20')
				run Sub_grp_Event16(NpadId=NpadId, ReadPadId=ReadPadId)
		else:
			if EventFlowSystemActor.CheckAmiiboNPC('cNNPC'):
				run Sub_grp_Event16(NpadId=NpadId, ReadPadId=ReadPadId)
			else:
				# You can't invite that client to a facility!
				EventFlowSystemActor.OpenMessageWindow('TalkObj/OBJ_WherearenAmiiboDevice:307', false)

local flow Sub_grp_Event16(NpadId: int, ReadPadId: int):
	if EventFlowSystemActor.CheckAmiiboNPC('cWherearenCustomer'):
		# You can't invite that client to a facility!
		EventFlowSystemActor.OpenMessageWindow('TalkObj/OBJ_WherearenAmiiboDevice:307', false)