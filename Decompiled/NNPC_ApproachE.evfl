flow FromFreeH_AN_MileTicket():
	# Bwa ha ha! I knew it! And that's why you've been running around—to get everything ready for 'em. Awesome!
	MainNpc.OpenMessageWindow('TalkNNpc/G4_An/Approach/AN_ApproachE_MainSeq:052', false)
	if System.EventFlags['cPlayer:HeardMileTourHintFromHAAN']:
		if (EventFlowSystemActor.SystemHasBaggageSpace('cPocketBag') >= 1) and (System.EventFlags['cPlayer:DodUseFirstFreeTour']):
			run Sub_Event106()
	else:
		# In that case, I've got a little tip that might help you out.
		MainNpc.OpenMessageWindow('TalkNNpc/G4_An/Approach/AN_ApproachE_MainSeq:053', false)
		# Ever been doing the DIY thing and run out of <item>iron nuggets or <item>clay? Word is the rocks on Mystery Tour islands are stuffed with the, uh… st…
		MainNpc.OpenMessageWindow('TalkNNpc/G4_An/Approach/AN_ApproachE_MainSeq:054', false)
		System.EventFlags['cPlayer:HeardMileTourHintFromHAAN'] = true
		if System.EventFlags['cPlayer:DodUseFirstFreeTour']:
			if EventFlowSystemActor.SystemHasBaggageSpace('cPocketBag') < 1:
				# Next time you do one of those tours, start wailing on rocks and see what happens. You might hit the jackpot!
				MainNpc.OpenMessageWindow('TalkNNpc/G4_An/Approach/AN_ApproachE_MainSeq:055', false)
			else:
				run Sub_Event106()
		else:
			# Hey! Didn't Tom Nook give you a <item>Nook Miles Ticket when you built your house, <110:5>? Why not use that next time you do one of those Mystery To…
			MainNpc.OpenMessageWindow('TalkNNpc/G4_An/Approach/AN_ApproachE_MainSeq:058', false)

