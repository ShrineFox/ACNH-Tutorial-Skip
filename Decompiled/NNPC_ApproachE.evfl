flow FromFreeH_HA_MileTicket():
	# So, you know rocks, right? And how you get stuff for hitting one with a shovel or an axe? You know that, right? It turns out that the faster you hit …
	MainNpc.OpenMessageWindow('TalkNNpc/B2_Ha/Approach/HA_ApproachE_MainSeq:052', false)
	# So you work your lats by swinging stuff around, then work endurance by carrying whatever comes out! And if you wanna max out, the rocks on Mystery To…
	MainNpc.OpenMessageWindow('TalkNNpc/B2_Ha/Approach/HA_ApproachE_MainSeq:053', false)
	System.EventFlags['cPlayer:HeardMileTourHintFromHAAN'] = true
	if not System.EventFlags['cPlayer:DodUseFirstFreeTour']:
		# Hold up a rep! Didn't Tom Nook give you a <item>Nook Miles Ticket? Why are you still here?
		MainNpc.OpenMessageWindow('TalkNNpc/B2_Ha/Approach/HA_ApproachE_MainSeq:056', false)
		# You'll see! The extra stuff from those rocks means you get more workout for your workout. Go get huge!
		MainNpc.OpenMessageWindow('TalkNNpc/B2_Ha/Approach/HA_ApproachE_MainSeq:055', false)
	elif EventFlowSystemActor.SystemHasBaggageSpace('cPocketBag') >= 1:
		MainNpc.SetDeliveryItemAtRandom(5851, false, 'cVillageRemakePattern', 0)
		# Oh yeah! I messed up and got an extra <item>Nook Miles Ticket. You should take it, <110:5>.
		MainNpc.OpenMessageWindow('TalkNNpc/B2_Ha/Approach/HA_ApproachE_MainSeq:054', true)
		MainNpc.NpcDelivery(1, 'Keep')
		# You'll see! The extra stuff from those rocks means you get more workout for your workout. Go get huge!
		MainNpc.OpenMessageWindow('TalkNNpc/B2_Ha/Approach/HA_ApproachE_MainSeq:055', true)
		EventFlowSystemActor.SetItemToPocket(5851, 1)
		MainNpc.NpcDelivery(2, 'Default')

flow MileTourTicketSupport_AN():
	# Hey, so… Is it just me, or are things getting real new-neighbor-y around here? What's the deal?
	MainNpc.OpenMessageWindow('TalkNNpc/G4_An/Approach/AN_ApproachE_MainSeq:051', false)
	switch EventFlowSystemActor.GeneralTalkChoice2():
		case 0, 1:
			run FromFreeH_AN_MileTicket()

flow MileTourTicketSupport_HA():
	# I did it! I've invented a perfect island workout routine. And you can do it on ANY island! Check it out…
	MainNpc.OpenMessageWindow('TalkNNpc/B2_Ha/Approach/HA_ApproachE_MainSeq:051', false)
	run FromFreeH_HA_MileTicket()

local flow Sub_Event106():
	MainNpc.SetDeliveryItemAtRandom(5851, false, 'cVillageRemakePattern', 0)
	# And guess what? I just happen to have a <item>Nook Miles Ticket for you! Yep, I totally planned this.
	MainNpc.OpenMessageWindow('TalkNNpc/G4_An/Approach/AN_ApproachE_MainSeq:056', true)
	MainNpc.NpcDelivery(1, 'Keep')
	# You've been doing so much for this place it makes my head spin. Call it my way of chipping in. Have fun!
	MainNpc.OpenMessageWindow('TalkNNpc/G4_An/Approach/AN_ApproachE_MainSeq:057', true)
	EventFlowSystemActor.SetItemToPocket(5851, 1)
	MainNpc.NpcDelivery(2, 'Default')