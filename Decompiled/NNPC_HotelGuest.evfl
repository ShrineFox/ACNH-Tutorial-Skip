flow NamedOriginal():
	if not MainNpc.EventFlags['cHotelNpcMemory:SkipNamedTraveler']:
		EventFlowSystemActor.MessageSuspend()
		MainNpc.NpcChangeNameStatus(0)

flow NamedTraveler():
	if not MainNpc.EventFlags['cHotelNpcMemory:SkipNamedTraveler']:
		MainNpc.NpcChangeNameStatus(4)

