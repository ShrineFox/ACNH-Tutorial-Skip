		run HeardThanks_1201()
	elif MainNpc.EventFlags['cHotelNpcMemory:ThankedForMakingRoom']:
		run HeardThanks_1201()
	else:
		MainNpc.EventFlags['cHotelNpcMemory:ThankedForMakingRoom'] = true
		# RANDOM: Hold on, you designed this room?! Wow, … // I heard you made this room! That true? … // Wowie, you made this room? It's the bes…
		MainNpc.OpenMessageWindow('TalkNNpc/B1_Bo/HotelGuest/BO_HotelGuest:1301', false)

flow Greet_FirstTalk():
	run Check_TalkAtGuestRoom()
	if not EventFlowSystemActor.IsMyVillage():
		# RANDOM: Hey, it's me, <110:10>! I'm here on an … // Hello! I'm visiting from outta town. Hm… // Hmmm… You kinda have the look of someon…
		MainNpc.OpenMessageWindow('TalkNNpc/B1_Bo/HotelGuest/BO_HotelGuest:005', false)
	elif not MainNpc.IsHotelNpcAcquaintedWith():
		MainNpc.HotelNpcBecomeAcquainedWithPlayer()
		if MainNpc.IsLivedSameNpc() == 0:
			run No_acquaintance_001()
		elif MainNpc.IsAcquaintedWithSameNpc():
			# RANDOM: Oh, PLAYER! I used to live here, rememb… // Nice to meet you! My name's <110:10>. W… // Hm? Hold on, could you be…PLAYER?! It's…
			MainNpc.OpenMessageWindow('TalkNNpc/B1_Bo/HotelGuest/BO_HotelGuest:002', false)
		else:
			run No_acquaintance_001()
	elif MainNpc.IsLivedSameNpc() == 0:
		run No_acquaintance_003()
	elif MainNpc.IsAcquaintedWithSameNpc():
		# RANDOM: Hey! I'm back for some nostalgic chilli… // Huh? Uh, yeah, it's me again. Hi, PLAYE… // Heya, PLAYER! I'm back on the island ag…
		MainNpc.OpenMessageWindow('TalkNNpc/B1_Bo/HotelGuest/BO_HotelGuest:004', false)
	else:
		run No_acquaintance_003()

