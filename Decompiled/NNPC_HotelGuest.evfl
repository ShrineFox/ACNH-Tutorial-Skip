flow React_Shopping():
	run NNPC_HotelGuest_Reaction::ChangeNamePlate()
	MainNpc.SetItemColorName(23, 0)
	MainNpc.SetItemName(23, 0, 0)
	MainNpc.NpcOpenFacilityMessage()

flow React_Watcing():
	run NNPC_HotelGuest_Reaction::ChangeNamePlate()
	MainNpc.NpcOpenFacilityMessage()

flow Root():
	switch MainNpc.IsNpcType():
		case 0:
			run NNPC_HotelGuest_Reaction::Run()
			if MainNpc.EventFlags['cHotelNpcMemory:TalkedHotelNpc']:
				run Free()
			else:
				run Greet_FirstTalk()
		case 1:
			run SNPC_common_HotelGuest::Root()
		default:
			return

