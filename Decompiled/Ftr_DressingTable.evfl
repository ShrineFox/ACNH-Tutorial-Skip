flow Root():
	Player.PlayerWorkbenchThinking()
	EventFlowSystemActor.UICharactermakingCreate()
	EventFlowSystemActor.SetTagFromSystem('cStartFtrName', 'cDegit', 0, 0, '')
	if EventFlowSystemActor.SystemCheckNowStage('cCloudIslandAll'):
		# Should I change up my look with this <125:0:0000>? (You'll change back when you wake.)
		Player.OpenMessageWindow('TalkFtr/FTR_DressingTable:002', false)
	else:
		# Should I change up my look with this <125:0:0000>?
		Player.OpenMessageWindow('TalkFtr/FTR_DressingTable:001', false)
	if EventFlowSystemActor.GeneralTalkChoice2() == 0:
		EventFlowSystemActor.UICharactermakingHandling('cRemake')
		if EventFlowSystemActor.UIResultMenuDecide():
			EventFlowSystemActor.SaveSetFromUIResult('cCharaMakeResult')
			Player.PlayerChangeStateDemoTalk()
		else:
			Player.PlayerChangeStateDemoTalk()
	else:
		Player.PlayerChangeStateDemoTalk()