flow Cancel_Towntune():
	run Event7()

flow EditNewMelody():
	EventFlowSystemActor.UIMelodyEditHandling()
	switch EventFlowSystemActor.UIResultMelodyEdit():
		case 0:
			EventFlowSystemActor.SaveSetFromUIResult('cMelody')
			# Well, I do have a little musical knowledge… Allow me to preview the tune you created!
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:007', true)
			MainNpc.SzaPlayMelody()
			# How inspiring! Your new island tune makes me so proud to call ISLAND my home! Now then, we'll start using it right away! I hope you enjoy hearing it …
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:009', true)
			System.EventFlags['cLand:SzaSetTownTuneOriginalRecently'] = true
			EventFlowSystemActor.NpcPlayerActivity('cActivityType_ChangeMelody')
			MainNpc.SzaAchievementChangeSymbol('cMelody')
			EventFlowSystemActor.SetMemoryEventLand('cBlancoEventLand:LE_UpdateLandMelody')
		case 1:
			# Well, I do have a little musical knowledge… Allow me to preview the tune you created!
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:007', true)
			MainNpc.SzaPlayMelody()
			# This tune sounds very…familiar. Well, no sense fixing something that isn't broken! We'll keep it for now.
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:008', false)
		case 2:
entrypoint Event7:
			# Did you change your mind?<10:4> Not a problem. If there's anything else you need, you can find me right here!
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:006', false)
	run SNPC_sza_00_Common::Sza_CmnSel_Again()

flow Recommend():
	System.EventFlags['cPlayerTemp:SzaTowntuneRecommendEntryLoop'] = false
	# You want to know what tune I'd suggest? Well, I do have one in mind. What do you think of this?
	MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:009_03', true)
	if System.EventFlags['cLand:SzaSetTownTuneOriginalRecently']:
		switch EventFlowSystemActor.FlagSystemIntValue5(5, 'cLand:SzaResetTownTuneRecentlyNo'):
			case 0:
				run Sub_Event51()
			case 1:
				run Sub_Event43()
			case 2:
				run Sub_Event45()
			case 3:
				run Sub_Event47()
			case 4:
				run Sub_Event49()
	else:
		switch EventFlowSystemActor.FlagSystemIntValue5(5, 'cLand:SzaResetTownTuneRecentlyNo'):
			case 0:
				run Sub_Event51()
			case 1:
				run Sub_Event45()
			case 2:
				run Sub_Event47()
			case 3:
				run Sub_Event49()
			case 4:
				run Sub_Event43()
	switch EventFlowSystemActor.FlagSystemIntValue4(4, 'cPlayerTemp:SzaTowntuneRecommendCounter'):
		case 0:
			MainNpc.SzaPlayDefaultVillageMelody(0)
		case 1:
			MainNpc.SzaPlayDefaultVillageMelody(1)
		case 2:
			MainNpc.SzaPlayDefaultVillageMelody(2)
		case 3:
			MainNpc.SzaPlayDefaultVillageMelody(3)
	# How about it? Would you like to use it as our new island tune?
	MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:009_04', false)
entrypoint Event55:
	switch EventFlowSystemActor.GeneralTalkChoice3():
		case 0:
			switch EventFlowSystemActor.FlagSystemIntValue4(4, 'cPlayerTemp:SzaTowntuneRecommendCounter'):
				case 0:
					EventFlowSystemActor.SaveDefaultVillageMelody(0)
					System.EventFlags['cLand:SzaResetTownTuneRecentlyNo'] = 1
				case 1:
					EventFlowSystemActor.SaveDefaultVillageMelody(1)
					System.EventFlags['cLand:SzaResetTownTuneRecentlyNo'] = 2
				case 2:
					EventFlowSystemActor.SaveDefaultVillageMelody(2)
					System.EventFlags['cLand:SzaResetTownTuneRecentlyNo'] = 3
				case 3:
					EventFlowSystemActor.SaveDefaultVillageMelody(3)
					System.EventFlags['cLand:SzaResetTownTuneRecentlyNo'] = 4
			# Alright! I think we've got ourselves a new island tune!
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:009_08', false)
			System.EventFlags['cLand:SzaSetTownTuneOriginalRecently'] = false
			run SNPC_sza_00_Common::Sza_CmnSel_Again()
		case 1:
			run RecommendOther()
		case 2:
			run Cancel_Towntune()

flow RecommendOther():
	# Hmm, what about this tune?
	MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:009_05', false)
	if EventFlowSystemActor.FlagSystemIntValue4(4, 'cPlayerTemp:SzaTowntuneRecommendCounter') in (0, 1, 2):
		System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounter'] += 1
	else:
		System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounter'] = 0
	if EventFlowSystemActor.EventFlagSystemComqare('cPlayerTemp:SzaTowntuneRecommendCounter', 'cPlayerTemp:SzaTowntuneRecommendCounterStart') not in (0, 2):
		System.EventFlags['cPlayerTemp:SzaTowntuneRecommendEntryLoop'] = true
	switch EventFlowSystemActor.FlagSystemIntValue4(4, 'cPlayerTemp:SzaTowntuneRecommendCounter'):
		case 0:
			MainNpc.SzaPlayDefaultVillageMelody(0)
		case 1:
			MainNpc.SzaPlayDefaultVillageMelody(1)
		case 2:
			MainNpc.SzaPlayDefaultVillageMelody(2)
		case 3:
			MainNpc.SzaPlayDefaultVillageMelody(3)
	if System.EventFlags['cPlayerTemp:SzaTowntuneRecommendEntryLoop']:
		# Um… That was exactly the same as the one I shared with you before. What do you think after hearing it again?
		MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:009_07', false)
		run Event55()
	else:
		# What did you think of that one?
		MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:009_06', false)
		run Event55()

flow Root():
	EventFlowSystemActor.UIMelodyEditCreate()
	if not System.EventFlags['cPlayer:ShizueCmnExplanationTowntune']:
		# I'm certain you've heard the current ISLAND island tune! You really can't miss it. It plays in multiple locations across the island, and it reminds u…
		MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:004', true)
		System.EventFlags['cPlayer:ShizueCmnExplanationTowntune'] = true
		run EditNewMelody()
	elif EventFlowSystemActor.HasChangedVillageMelody():
		# Oh! You want to compose a new island tune?
		MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:009_01', false)
		switch EventFlowSystemActor.GeneralTalkChoice3():
			case 0:
				# OK! Give us a tune that captures the essence of ISLAND!
				MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:009_02', true)
				run EditNewMelody()
			case 1:
				run Recommend()
			case 2:
				run Cancel_Towntune()
	else:
		# You'd like to compose a new tune for ISLAND right now? That's great news! I knew I could count on you, maestro! Let's hear your lovely tune.
		MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:005', true)
		run EditNewMelody()

local flow Sub_Event43():
	System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounterStart'] = 0
	System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounter'] = 0

local flow Sub_Event45():
	System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounterStart'] = 1
	System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounter'] = 1

local flow Sub_Event47():
	System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounterStart'] = 2
	System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounter'] = 2

local flow Sub_Event49():
	System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounterStart'] = 3
	System.EventFlags['cPlayerTemp:SzaTowntuneRecommendCounter'] = 3

local flow Sub_Event51():
	switch EventFlowSystemActor.RandomChoice4(4):
		case 0:
			run Sub_Event43()
		case 1:
			run Sub_Event45()
		case 2:
			run Sub_Event47()
		case 3:
			run Sub_Event49()