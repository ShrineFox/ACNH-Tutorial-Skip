flow Root():
	if not System.EventFlags['cPlayer:HotelUnlockDIYTrade']:
		# I wonder what this is…
		Player.OpenMessageWindow('TalkSys/SYS_Player:1801', false)
	elif (not EventFlowSystemActor.NetIsDreaming()) and (EventFlowSystemActor.IsMyVillage()):
		# How to Use the DIY Donation Box Please contribute your DIY items! Craft the requested items, and put them in the box to earn hotel tickets. A fulfill…
		EventFlowSystemActor.OpenMessageWindow('TalkObj/OBJ_TradeBox:052', false)
	else:
		# The box cannot be used at this time.
		EventFlowSystemActor.OpenMessageWindow('TalkObj/OBJ_TradeBox:051', true)