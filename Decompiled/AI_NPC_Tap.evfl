flow Init():
	MainNpc.NpcAISetting(8, true)
	MainNpc.NpcRegistAIBlackBoard('SpeakTypeBed', 1)
	if not EventFlowSystemActor.SystemCheckNowStage('cCloudIsland'):
		MainNpc.NpcAISetRequestSpeakFunc('cDreamBedInPlaza', false)
		if EventFlowSystemActor.SystemCheckNowStage('cIdrDream'):
			if System.EventFlags['cLandTemp:TapIndoorPos']:
				MainNpc.NpcAISetPosByRail(0, 1, true, 60.0)
			else:
				MainNpc.NpcAISetPosByRail(0, 0, true, 90.0)
	elif not EventFlowSystemActor.NetHasVisitor():
		MainNpc.NpcAISetRequestSpeakFunc('cDreamBedInPlaza', false)

flow Root():
	if EventFlowSystemActor.SystemCheckNowStage('cCloudIsland'):
		if (not EventFlowSystemActor.NetHasVisitor()) and (not System.EventFlags['cPlayerTemp:TapCloudIslandFirstTalkDone']):
			MainNpc.NpcAISetting(4, false)
			run AI_NPC_Common::ContinueSpeak(FlowName='SNPC_tap_03_InCloudIsland', EntryName='Force_Entry')
		else:
			MainNpc.NpcChangeSpNpcTurnState('cSpNpcTurn', '', 'SNPC_tap_03_InCloudIsland', 'Root', false, true, ArgFlag0=true, ArgFlag1=false, ArgFloat0=0.0, ArgInt0=30, ArgInt1=2, ArgInt2=0, ArgInt3=0, ArgStr0='', ArgStr1='')
	elif EventFlowSystemActor.SystemCheckNowStage('cIdrDream'):
		MainNpc.NpcAISetting(4, false)
		run AI_NPC_Common::ContinueSpeak(FlowName='SNPC_tap', EntryName='Root')
	elif System.EventFlags['cLandTemp:TapDreamFirstTalkDone']:
		MainNpc.NpcChangeSpNpcTurnState('cSpNpcTurn', '', 'SNPC_tap_02_InDreaming', 'InDreamTalk', false, true, ArgFlag0=true, ArgFlag1=false, ArgFloat0=0.0, ArgInt0=30, ArgInt1=1, ArgInt2=0, ArgInt3=0, ArgStr0='', ArgStr1='')
	else:
		MainNpc.NpcAISetting(4, false)
		run AI_NPC_Common::ContinueSpeak(EntryName='Root', FlowName='SNPC_tap_02_InDreaming')