flow ExitStrc():
	MainNpc.NpcChangeAIState('cExitReaction', '', '', '', false, false)

flow Init():
	MainNpc.ServiceMotionControl(false)

flow Root():
	MainNpc.NpcAIDefaultSetting(1)
	if MainNpc.IsSleepHotelNpcInHotelRoom():
		MainNpc.NpcChangeAIState('cHotelStandSleep', '', 'NNPC_HotelGuest', 'StandSleep_HotelGuestRoom', true, false)
	else:
		MainNpc.NpcChangeHeadCtrlMode('cNormal', true)
		MainNpc.SetIsStartHoteActivity('cOn')