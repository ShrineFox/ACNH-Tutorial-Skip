flow Root(ItemPrice: int = 0):
	if not System.EventFlags['cPlayerTemp:FirstTalkedCloudIslandGyroid']:
		System.EventFlags['cPlayerTemp:FirstTalkedCloudIslandGyroid'] = true
		if EventFlowSystemActor.IsCloudIslandIdOverwrited():
			# Welcome to ISLAND! I'm here to support you as you make your dreams a reality.
			HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:001', false)
		else:
			# Welcome! I'm here to support you as you make your idyllic dreams a reality!
			HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:001_01', false)
	if not EventFlowSystemActor.NetHasVisitor():
		run HostSelect()
	elif EventFlowSystemActor.NetIsInviteFriend():
		run HostSelect()
	else:
		# If you have any construction goals, please pass them along to the host of this dream.
		HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:004', false)
		run Pitfall_Guest()

