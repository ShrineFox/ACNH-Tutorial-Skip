			case 2:
				# Ah, changed your mind about the <125:0:0000>, then? In that case, I'll just take back that <item>dream incline kit. If you do decide to build an incl…
				HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:431', false)
				EventFlowSystemActor.DeleteTargetItem(910, 1, false)
	elif EventFlowSystemActor.CloudIslandSlopeNum(10):
		# Now, listen. There is a limit of 10 inclines on a single island. If you'd like to build a new incline, you'll need to destroy one of the existing inc…
		HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:451', false)
		run ReSelect()
	else:
