flow ReSel_BridgeCatalog():
	# Please select the type of bridge you'd like to build here.
	HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:302', true)
	EventFlowSystemActor.UIShopBuyHandling('cCloudIslandBridge')
	if EventFlowSystemActor.UIResultMenuDecide():
		EventFlowSystemActor.SetTagFromUIResult('cItemName', 0)
		# And you're happy with your choice? The <125:0:0000>?
		HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:303', false)
		switch EventFlowSystemActor.GeneralTalkChoice3():
			case 0:
				# Excellent! Then let me give you the <item>dream bridge kit you'll be needing. Use it next to a river. Find a spot where a bridge will fit nicely, and…
