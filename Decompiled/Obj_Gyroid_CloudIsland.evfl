		run ReSel_SlopeCatalog()

local flow Sub_Event12():
	EventFlowSystemActor.CloudIslandStructureRequestLock('cBuildRange', 'cHouseChange', 'cCloudIslandPlayerHouse')
	if EventFlowSystemActor.CloudIslandStructureIsLockSuccess('cBuildRange', 'cHouseChange'):
		EventFlowSystemActor.CloudIslandStructureLockEffect()
		EventFlowSystemActor.MessageSuspend()
		EventFlowSystemActor.UICloudIslandCustomHomeHandling()
		if EventFlowSystemActor.UIResultMenuDecide():
			EventFlowSystemActor.CloudIslandStructureWaitHouseChange()
			# I've finished the renovations. Please check to see that everything is the way you want it.
			HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:103', true)
			run ReSelect()
		else:
			EventFlowSystemActor.CloudIslandStructureCancelLock()
			run ReSelect()
	else:
		run Reform_Failure()