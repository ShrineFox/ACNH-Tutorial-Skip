flow ReSelect():
	# Will there be anything else?
	HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:051', false)
	run Event87()

flow Reform():
	# Of course, chum! I can help you with your renovations.
	HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:101', false)
	if EventFlowSystemActor.NetHasVisitor():
		# Now, I can't carry out renovations if anyone is in the house or near it. So, are you ready to begin?
		HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:102', false)
		if EventFlowSystemActor.GeneralTalkChoice2() == 0:
			if EventFlowSystemActor.CloudIslandStructureIsExistPlayerInHouse():
				run Reform_Failure()
			else:
				run Sub_Event12()
		else:
			run ReSelect()
	else:
		# Within a dream, I can instantly change the way your house looks.
		HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:101_01', false)
		run Sub_Event12()

flow Reform_Failure():
	# Unfortunately, it seems someone is either in the house or near it… Please put in your request when no one is in or near your house.
	HaniwaKun.OpenMessageWindow('TalkObj/OBJ_Gyroid_CloudIsland:151', true)
	EventFlowSystemActor.CloudIslandStructureCancelLock()
	run ReSelect()

