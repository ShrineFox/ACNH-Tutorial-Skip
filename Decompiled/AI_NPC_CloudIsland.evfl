flow FallPit():
	MainNpc.NpcAISetting(2, false)
	MainNpc.NpcAISetting(3, false)
	MainNpc.NpcAISetting(8, true)
	MainNpc.NpcChangeAIState('cFallPitCI', '', '', '', false, false)

flow Hit():
	MainNpc.NpcChangeAIState('cHit', '', '', '', false, false)

flow Root():
	MainNpc.NpcAIDefaultSetting(1)
	MainNpc.NpcAISetting(4, false)
	MainNpc.NpcAISetting(24, true)
	MainNpc.SetIsStartCloudIslandActivity('cOn')