flow CheckAmiiboDevice():
	if System.EventFlags['cPlayer:FinishEditVIPRoomToday']:
		# Arr! Ye wanna invite someone to a VIP room? But ye've already invited someone else to a VIP room, ye know… If ye wanna invite someone different, ye'l…
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:5002', false)
		MainNpc.SetRobContinueForceCancel()
	else:
		EventFlowSystemActor.SetHotelRoomNumberTag('cSuspend', 0)
		# Avast! Ye were workin' on <50:1> <140:29:cd00>, yar? Well, lemme know if ye wanna continue workin' there.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm:5004', false)
		MainNpc.SetRobContinueForceCancel()