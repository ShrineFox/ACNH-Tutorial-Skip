flow Root():
	if System.EventFlags['cPlayer:SeqHotelEditTutorialDone']:
		run StopLeave2()
	else:
		run EditTutorial()

flow StartEdit():
	System.EventFlags['cPlayerTemp:HotelReserveKpmSpeak'] = false
	if not System.EventFlags['cPlayer:SeqHotelEditTutorialDone']:
		run EditTutorialStart()
	elif not EventFlowSystemActor.CheckHotelRoomCreated('cRoom2'):
		run EditStart()
	elif not EventFlowSystemActor.CheckHotelRoomCreated('cRoom3'):
		run EditStart()
	elif not EventFlowSystemActor.CheckHotelRoomCreated('cRoom4'):
		run EditStart()
	elif not EventFlowSystemActor.CheckHotelRoomCreated('cRoom5'):
		run EditStart()
	elif not EventFlowSystemActor.CheckHotelRoomCreated('cRoom6'):
		run EditStart()
	elif not EventFlowSystemActor.CheckHotelRoomCreated('cRoom7'):
		run EditStart()
	elif not EventFlowSystemActor.CheckHotelRoomCreated('cRoom8'):
		run EditStart()
	elif System.EventFlags['cPlayer:HotelVipRoomIntroductionDone']:
		run EditStart()
	else:
		# The decoratin' process is the same as before, but… If ye wonder if the room's suitable for yer guest, use  to imagine 'em in here an' see what ye th…
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:001_01', true)
		EventFlowSystemActor.HotelOrderCallback('cEditStart')
		EventFlowSystemActor.HotelEditBGMStart()

