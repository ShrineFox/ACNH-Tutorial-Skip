flow VIPRoomInpressionFirst():
	EventFlowSystemActor.SetTagHotelVisitorNpcName('cInvitedVIP', 0)
	if not EventFlowSystemActor.CheckHotelRoomFtrNum(3):
		# It be quite the simple room, yar? Decoratin' be a tough job…
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_01_04', true)
	elif EventFlowSystemActor.RandomChoiceExcludePrevious2(2, true) == 0:
		# This be a nice room, an' a memorable one fer guests, no doubt.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_03', true)
	else:
		# This be fittin' fer a VIP room! <115:1:cd00>'ll love it.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_03_01', true)

flow VIPRoomInpressionSecond():
	EventFlowSystemActor.SetTagHotelVisitorNpcName('cInvitedVIP', 0)
	if not EventFlowSystemActor.CheckHotelRoomFtrNum(3):
		# It be quite the simple room, yar? Decoratin' be a tough job…
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_01_04', true)
	elif EventFlowSystemActor.RandomChoiceExcludePrevious2(2, true) == 0:
