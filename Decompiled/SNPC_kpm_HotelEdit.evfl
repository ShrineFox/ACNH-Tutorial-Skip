		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_03_02', true)
	else:
		# What a nice room! I can't wait to show it off to <115:1:cd00>!
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_03_03', true)

flow VIPTutorial():
	MainNpc.TurnNeck(11, false)
	MainNpc.TurnBody(18, 0.0)
	EventFlowSystemActor.WaitFrame(20)
	if not EventFlowSystemActor.CheckHotelEditEndCondition('cIsEntranceSpace'):
		EventFlowSystemActor.WaitFrame(20)
		MainNpc.TurnBody(10, 0.0)
		# Arr… Sorry, but…ye gotta leave some entry room! Guests need ta get in an' outta their rooms, do they not?
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:113', true)
	elif not EventFlowSystemActor.CheckHotelEditEndCondition('cIsSpaceInRoom'):
		EventFlowSystemActor.WaitFrame(20)
		MainNpc.TurnBody(10, 0.0)
		# It's…a bit cramped. The guests are gonna want at least a little space fer relaxin', don't ye think?
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:113_01', false)
	elif not EventFlowSystemActor.CheckHotelEditEndCondition('cIsExistFtr'):
		EventFlowSystemActor.WaitFrame(20)
		MainNpc.TurnBody(10, 0.0)
		# Arrr! Me voice is still echoing in here. Why don't ye try puttin' down some furniture.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:111_01', false)
	elif EventFlowSystemActor.HotelOrderType() in (0, 2, 3):
		if not EventFlowSystemActor.IsEditHotelVIPRoom():
			run NomalRoomInpression()
			run EndEdit()
		elif EventFlowSystemActor.CheckHotelRoomCreated('cNowPlayerVIP'):
			if EventFlowSystemActor.HotelOrderType() in (0, 2, 3):
				run VIPRoomInpressionSecond()
				run Sub_Event172()
			else:
				run Sub_Event135()
		else:
			run VIPRoomInpressionFirst()
			System.EventFlags['cPlayer:HotelCoordinatedVIPCount'] += 1
			if EventFlowSystemActor.IsVIPNpcAmiibo():
				System.EventFlags['cPlayer:HotelCoordinatedVIPCount_amiibo'] += 1
				MainNpc.TurnBody(10, 0.0)
				# Yar! Our guest be about to arrive! It's time to greet 'em and show 'em the room.
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_04', true)
			else:
				System.EventFlags['cPlayer:HotelCoordinatedVIPCount_VisitingNPC'] += 1
				MainNpc.TurnBody(10, 0.0)
				# Now, we'd best be showin' our guest to their room!
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_05', true)
				System.EventFlags['cPlayer:HotelVIPTutorialEndExplanation'] = true
			MainNpc.CharacterEmoticonAction('Greeting', true, '', 0, false)
			EventFlowSystemActor.WaitFrame(10)
			EventFlowSystemActor.SystemBGMVolumeFadeOut(1.0, 0, 0.0)
			EventFlowSystemActor.RequestDuckingNextWiping()
			run `00_Demo_Fade`::FadeOut_Cmn(FadeType='cCircle', FadeColor='cBlack', FadeSpeed='cNormal', SoundDucking='cWorldDucking')
			if EventFlowSystemActor.IsFindNpcByLabel('cml'):
				run CmlVIPFirstEditEnd()
			else:
				EventFlowSystemActor.NpcSetPos(165.0, 220.0, 180.0, '-Hotel:VIP')
				EventFlowSystemActor.SetNpcAIBlackBoardByLabel('-Hotel:VIP', 'ReserveVIPFinish', 1, 1)
	else:
		run Sub_Event135()