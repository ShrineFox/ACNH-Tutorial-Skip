		MainNpc.NpcWaitTurn(false)
	fork:
		branch:
			MainNpc.CharacterEmoticonAction('OkayOnehandLeft', true, '', 0, false)
		branch:
			Player.CharacterEmoticonAction('OkayOnehandLeft', true, '', 0, false)
