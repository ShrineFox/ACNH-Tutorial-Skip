flow CancelCodinate():
	# What? Ye're quittin'?
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:004', false)
	if EventFlowSystemActor.GeneralTalkChoice2() == 0:
		# If ye quit, the room will go back to how it was before ye started. That gonna be OK?
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:008', false)
		if EventFlowSystemActor.GeneralTalkChoice2() == 0:
			if EventFlowSystemActor.IsEditHotelVIPRoom():
				# Yar… I'll explain it to our guest. Ye just come decorate when ye've got time.
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:006', true)
			else:
				# Got it. Then let's sail back to the lobby.
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:005', true)
			System.EventFlags['cPlayer:HotelEditCameraExplanation'] = false
			EventFlowSystemActor.HotelOrderCallback('cCancelOrder')
			run StopReturnEntrance()
		else:
			# Got it. I'll leave ye to do the rest, then.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:005_01', true)
	else:
		# Got it. I'll leave ye to do the rest, then.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:005_01', true)

flow CmlVIPFirstEditEnd():
	EventFlowSystemActor.SetNpcAIBlackBoardByLabel('cml', 'ReserveForErase', 1, 1)
	EventFlowSystemActor.WaitFrame(6)
	EventFlowSystemActor.SetupActorPosition(21)
	EventFlowSystemActor.WaitFrame(6)

flow EditStart():
	# When ye're done, come talk to me. And now, I'll leave it in yer hands.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:001', true)
	EventFlowSystemActor.HotelOrderCallback('cEditStart')
	EventFlowSystemActor.HotelEditBGMStart()

flow EditTutorial():
	if System.EventFlags['cPlayer:HotelEditCameraExplanation']:
		# What's the scuttlebutt?
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:106', false)
		switch EventFlowSystemActor.GeneralTalkChoice4():
			case 0:
				run FinishedCodinate()
			case 1:
				run CancelCodinate()
			case 2:
				run ExplainEdit()
			case 3:
				run Nothing()
	else:
		# Oh! Yar! When ye're done decoratin', I want ye to take a photo usin' yer Camera app. The photos ye take'll get used fer the guest-rooms guide.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:103_02', false)
		System.EventFlags['cPlayer:HotelEditCameraExplanation'] = true

flow EditTutorialStart():
	EventFlowSystemActor.WaitFrame(20)
	if System.EventFlags['cLand:HotelIsCompletedEditTutorialAnyone']:
		if EventFlowSystemActor.IsEditHotelVIPRoom():
			# This be the VIP room. I want ye to decorate it, PLAYER.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:101_03', false)
		else:
			EventFlowSystemActor.SetHotelRoomNumberTag('cEditting', 0)
			# This be <50:1><140:29:cd00>. I want ye to start off by decoratin' here.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:150', false)
	else:
		# This here be room 1! I want ye ta start decoratin' here.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:101', false)
	# Decorate the room so it looks nice. I mean placin' furniture and changin' the wallpaper and floorin' and such.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:005_03', false)
	# Press  to enter Decorating Mode. It'll make the whole process easier.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:102', false)
	# An' if ye pick , ye can take out all the furniture ye know, so use what ye've got.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:103', false)
	if EventFlowSystemActor.IsEditHotelVIPRoom():
		# An' don't forget—ye can use  to imagine the guest visitin' the room. If ye're wonderin' if the room suits yer guest, give yer imagination a try!
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:151_01', false)
	if System.EventFlags['cLand:HotelIsCompletedEditTutorialAnyone']:
		EventFlowSystemActor.SetHotelThemeMessageTag('CurrentTheme', 0)
		# The theme for this one was… <140:28:cd00>.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:152', false)
		# I've put some furniture that matches the theme on the Recommended tab in , so head there if ye're lost.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:153', false)
	else:
		EventFlowSystemActor.SetHotelRoomNumberTag('cEditting', 0)
		# Arrr…instead o' havin' similar rooms, I'm thinkin' a variety o' rooms is what'll make our guests happy. Shakin' up the themes so every room o' the ho…
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:114_01', false)
		# That's why I've prepared some room themes—so ye can be designin' based on the mood ye're feelin'. Fer example, with <50:1><140:29:cd00>, I'm thinkin'…
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:115', false)
	# That bein' said, I'll leave it up to yer considerable artistic senses. Ye gotta do it yer way, PLAYER.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:005_04', false)
	# When ye're done with yer decoratin', or if ye're unsure of anythin', come jabber with me! And now, I'll leave ye to it.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:105', true)
	EventFlowSystemActor.HotelEditBGMStart()
	EventFlowSystemActor.ExitFlowchart()

flow EmotionReturnEntrance_VIP():
