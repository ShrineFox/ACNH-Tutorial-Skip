flow FinishedCodinate():
	# Oh me stars! Are ye finished?
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:109', false)
	if EventFlowSystemActor.IsEditHotelVIPRoom():
		run VIPTutorial()
	else:
		MainNpc.TurnNeck(11, false)
		MainNpc.TurnBody(18, 0.0)
		EventFlowSystemActor.WaitFrame(20)
		if not EventFlowSystemActor.CheckHotelEditEndCondition('cIsEntranceSpace'):
			EventFlowSystemActor.WaitFrame(20)
			MainNpc.TurnBody(10, 0.0)
			# Arr… Sorry, but…ye gotta leave some entry room! Guests need ta get in an' outta their rooms, do they not?
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:113', true)
		elif not EventFlowSystemActor.CheckHotelEditEndCondition('cIsSpaceInRoom'):
			EventFlowSystemActor.WaitFrame(20)
			MainNpc.TurnBody(10, 0.0)
			# It's…a bit cramped. The guests are gonna want at least a little space fer relaxin', don't ye think?
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:113_01', false)
		elif EventFlowSystemActor.CheckHotelEditEndCondition('cIsExistFtr'):
			if EventFlowSystemActor.CheckHotelRoomFtrNum(3):
				# What a wonderful room! The guests are gonna love it!
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:110', true)
			else:
				# It be quite the simple room, yar? Decoratin' be a tough job…
				MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_01_04', false)
			MainNpc.TurnBody(10, 0.0)
			# Let's sail back to the lobby together.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_06', true)
			EventFlowSystemActor.HotelOrderCallback('cEditEnd')
			if not System.EventFlags['cLand:HotelIsCompletedEditTutorialAnyone']:
				EventFlowSystemActor.ChooseFirstHotelVisitorNpc()
			run ReturnEntrance()
		else:
			EventFlowSystemActor.WaitFrame(20)
			MainNpc.TurnBody(10, 0.0)
			# Arrr! Me voice is still echoing in here. Why don't ye try puttin' down some furniture.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:111_01', true)

flow NomalRoomInpression():
	if EventFlowSystemActor.CheckHotelRoomFtrNum(3):
		if EventFlowSystemActor.RandomChoiceExcludePrevious2(2, true) == 0:
			# Shiver me timbers! What a wonderful room! I'd love ta stay in such a spot.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_01', true)
		else:
			# It be wonderful! Ye've got a popular room on yer hands. No doubt.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_01_01', true)
	else:
		# It be quite the simple room, yar? Decoratin' be a tough job…
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_01_04', true)
	MainNpc.TurnBody(10, 0.0)
	# Let's sail back to the lobby together.
	MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:003_06', true)

