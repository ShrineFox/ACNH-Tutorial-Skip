		else:
			# I'll leave ye to do the rest, then.
			MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:005_02', false)
	else:
		# I'll leave ye to do the rest, then.
		MainNpc.OpenMessageWindow('TalkSNpc/kpm/SP_kpm_HotelEdit:005_02', false)

