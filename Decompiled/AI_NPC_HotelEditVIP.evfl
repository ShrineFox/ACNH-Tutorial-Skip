flow Init():
	MainNpc.NpcRegistAIBlackBoard('ReserveVIPFinish', 0)
	MainNpc.NpcRegistAIBlackBoard('ReserveForErase', 0)
	MainNpc.NpcRegistAIBlackBoard('RequestInvisible', 0)
	MainNpc.ServiceMotionControl(false)

flow Root():
	MainNpc.NpcAIDefaultSetting(1)
	if MainNpc.NpcBlackBoard('ReserveVIPFinish', 1):
		MainNpc.NpcSetAIBlackBoard('ReserveVIPFinish', 0)
		MainNpc.ClearNoTalkDemoDelegate()
		MainNpc.NpcAISetting(4, false)
		if MainNpc.IsHotelGuestBeforeStaying():
			MainNpc.ResetClothesImmediatelyForWandering()
		run AI_NPC_Common::ContinueSpeak(EntryName='VIPFinish', FlowName='NNPC_HotelGuest_FinishVIPEdit')
	elif MainNpc.NpcBlackBoard('ReserveForErase', 1):
		MainNpc.NpcReservrForErase()
	elif MainNpc.NpcBlackBoard('RequestInvisible', 1):
		MainNpc.NpcSetAIBlackBoard('RequestInvisible', 0)
		MainNpc.NpcChangeAIState('cVipInvisible', '', '', '', true, false)
	else:
		if MainNpc.IsHotelGuestNpcInvisible():
			MainNpc.NpcChangeAIState('cVipInvisible', '', '', '', true, false)
		else:
			MainNpc.NpcAISetting(7, false)
			MainNpc.NpcAISetting(2, false)
			MainNpc.NpcAISetting(9, false)
			MainNpc.NpcChangeAIState('cWait', '', '', '', true, false)