flow Cancel_Flag():
	run Event3()

flow Root():
	if not System.EventFlags['cPlayer:ShizueCmnExplanationTownflag']:
		# You want to change the flag in front of Resident Services? And the one at the airport too? Fantastic! Our flag is the physical embodiment of everythi…
		MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:010', true)
		System.EventFlags['cPlayer:ShizueCmnExplanationTownflag'] = true
entrypoint Event8:
		EventFlowSystemActor.UIMyDesignSelectHandling(0, 1, 0, 0, 0)
		if EventFlowSystemActor.UIResultMenuDecide():
			EventFlowSystemActor.SaveSetFromUIResult('cFlag')
			# Oh my, PLAYER! It's perfect in every way! It truly captures the essence of ISLAND. From this point forward, your design will be our new flag.<10:4> T…
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:012', false)
			EventFlowSystemActor.NpcPlayerActivity('cActivityType_ChangeFlag')
			MainNpc.SzaAchievementChangeSymbol('cFlag')
			System.EventFlags['cLand:SzaChangeSymbol'] = true
			System.EventFlags['cLand:SzaResetSymbolRecently'] = false
			EventFlowSystemActor.SetMemoryEventLand('cBlancoEventLand:LE_UpdateLandFlag')
			run SNPC_sza_00_Common::Sza_CmnSel_Again()
		else:
entrypoint Event3:
			# Did you change your mind?<10:4> Not a problem. If there's anything else you need, you can find me right here!
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:006', false)
			run SNPC_sza_00_Common::Sza_CmnSel_Again()
	elif (EventFlowSystemActor.HasChangedLandFlag()) and (not System.EventFlags['cLand:SzaResetSymbolRecently']):
		# Oh! You'd like to submit a new design for the flag?
		MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:012_01', false)
		switch EventFlowSystemActor.GeneralTalkChoice3():
			case 0:
				# Then can you please show me your design?
				MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:012_02', true)
				run SelectNewdesign()
			case 1:
				# The original design? Yes, we can use the design of the first flag we flew back when we built our Resident Services building. Would you like me to pul…
				MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:012_03', false)
				if EventFlowSystemActor.GeneralTalkChoice2() == 0:
					# Alright, then I'll change the flag back to our original design. If you come up with a new flag design, please come by and share it with me!
					MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:012_04', false)
					EventFlowSystemActor.SaveDefaultLandFlag()
					System.EventFlags['cLand:SzaResetSymbolRecently'] = true
					run SNPC_sza_00_Common::Sza_CmnSel_Again()
				else:
					run Cancel_Flag()
			case 2:
				run Cancel_Flag()
	else:
		# You'd like to submit a new design for the flag? Great!<10:4> Let's see what you came up with!
		MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:011', true)
entrypoint Event8:
		EventFlowSystemActor.UIMyDesignSelectHandling(0, 1, 0, 0, 0)
		if EventFlowSystemActor.UIResultMenuDecide():
			EventFlowSystemActor.SaveSetFromUIResult('cFlag')
			# Oh my, PLAYER! It's perfect in every way! It truly captures the essence of ISLAND. From this point forward, your design will be our new flag.<10:4> T…
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:012', false)
			EventFlowSystemActor.NpcPlayerActivity('cActivityType_ChangeFlag')
			MainNpc.SzaAchievementChangeSymbol('cFlag')
			System.EventFlags['cLand:SzaChangeSymbol'] = true
			System.EventFlags['cLand:SzaResetSymbolRecently'] = false
			EventFlowSystemActor.SetMemoryEventLand('cBlancoEventLand:LE_UpdateLandFlag')
			run SNPC_sza_00_Common::Sza_CmnSel_Again()
		else:
entrypoint Event3:
			# Did you change your mind?<10:4> Not a problem. If there's anything else you need, you can find me right here!
			MainNpc.OpenMessageWindow('TalkSNpc/sza/SP_sza_0_common:006', false)
			run SNPC_sza_00_Common::Sza_CmnSel_Again()

flow SelectNewdesign():
	run Event8()